# Copiá este archivo a .env y completá la key.
# La API key vive SOLO acá, nunca en la base ni en los dumps de LlmCall.

# --- proveedor de LLM ---
# "openrouter": modelos :free, gratis pero flojos y con cupo diario por cuenta.
# "bedrock":    pago por token, con tool use forzado que garantiza JSON valido.
LLM_PROVIDER=openrouter

OPENROUTER_API_KEY=sk-or-v1-...

# Opcionales (estos son los defaults)
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=1
REDIS_URL=redis://127.0.0.1:6379/0

# Cupo diario de la cuenta en OpenRouter para modelos :free.
# 50 si tenés menos de USD 10 en créditos de por vida, 1000 si tenés 10 o más.
OPENROUTER_DAILY_QUOTA=50

# Poné 1 para trabajar contra fixtures/llm/ sin gastar cupo real.
FAKE_LLM=0

# --- Bedrock (solo si LLM_PROVIDER=bedrock) ---
# Credenciales por la cadena estandar de boto3: rol de instancia en EC2, AWS_PROFILE
# en local. Nunca una key en el .env.
#
# DeepSeek v4 Flash NO existe en Bedrock. Los DeepSeek disponibles son v3.2 (ON_DEMAND,
# el default) y r1 (necesita perfil de inferencia).
#   deepseek.v3.2          ~USD 0,0052 por CV, la mejor calidad de las tres
#   amazon.nova-lite-v1:0  ~USD 0,0005 por CV, unas 10 veces mas barato
#   amazon.nova-micro-v1:0 ~USD 0,0003 por CV, el mas barato
BEDROCK_MODEL_ID=deepseek.v3.2
BEDROCK_FALLBACK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_REGION=us-east-1
# Tope de gasto diario. Con registro abierto, un proveedor pago sin tope es una
# superficie de abuso.
BEDROCK_DAILY_USD_BUDGET=2.00

# Tope de CVs por usuario cada 24 h.
JOBS_PER_USER_PER_DAY=15

# Ruta al binario de LaTeX. Tectonic es el default.
TECTONIC_BIN=tectonic
