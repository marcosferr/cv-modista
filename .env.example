# Copiá este archivo a .env y completá la key.
# La API key vive SOLO acá, nunca en la base ni en los dumps de LlmCall.

OPENROUTER_API_KEY=sk-or-v1-...

# Opcionales (estos son los defaults)
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=1
REDIS_URL=redis://127.0.0.1:6379/0

# Cupo diario de la cuenta en OpenRouter para modelos :free.
# 50 si tenés menos de USD 10 en créditos de por vida, 1000 si tenés 10 o más.
OPENROUTER_DAILY_QUOTA=50

# Poné 1 para trabajar contra fixtures/llm/ sin gastar cupo real.
FAKE_LLM=0

# Ruta al binario de LaTeX. Tectonic es el default.
TECTONIC_BIN=tectonic
